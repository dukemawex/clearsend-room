# ClearSend Room Environment Variables
# Copy this file to .env and fill in your values

# ===== AI Model Configuration (FREE MODELS ONLY) =====
# OpenRouter free models - no API key required
OPENROUTER_API_KEY=
# Options: nvidia/nemotron-3-ultra-550b-a55b:free, google/gemma-4-31b-it:free
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_MODEL_NAME=google/gemma-4-31b-it:free

# NVIDIA API (alternative free option)
NVIDIA_API_KEY=

# ===== Switch Configuration =====
# The Switch server URL (default for local Switch Console)
SWITCH_SERVER_URL=http://localhost:8000
SWITCH_AGENT_TOKEN=

# ===== Chat Platform Configuration =====
# Pick ONE: Slack, Discord, Telegram, or Mattermost
# Slack (create app at api.slack.com/apps)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Discord (create app at discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Mattermost (included with Switch Console, no config needed)
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOT_TOKEN=
MATTERMOST_TEAM=

# ===== PayPal Sandbox Configuration =====
# Create sandbox app at developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ===== Upstash Redis Configuration =====
# Create free database at console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Escrow Security =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ESCROW_LINK_SECRET=

# ===== Flight Data APIs (Optional for enhanced data) =====
# RapidAPI Sky-Scrapper API (optional, has free tier)
RAPIDAPI_KEY=

# ===== Next.js Dashboard =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
